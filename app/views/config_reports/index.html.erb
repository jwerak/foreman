<%= breadcrumbs(
    items: [
    {
      caption: _("Hosts"),
      url: (current_hosts_path if authorized_for(hash_for_hosts_path))
    },
    {
      caption: @host.name,
      url: (current_host_details_path(@host) if authorized_for(hash_for_host_path(@host)))
    },
    {
      caption: _('Reports'),
      url: config_reports_path(search: 'eventful=true')
    },
  ]
) if @host %>
<% title _("Reports") %>
<%= react_component('ConfigReportsIndex', react_index_props(ConfigReport, creatable: false, exportable: true, export_url: url_for(format: :csv, search: params[:search]), documentation_url: documentation_url('3.5.4PuppetReports'))) %>
