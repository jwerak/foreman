<div class="modal fade" id="<%= id %>" tabindex="-1" role="dialog" aria-labelledby="<%= id %>Label" style="display:none">
  <div class="modal-dialog <%= defined?(big) ? 'modal-big' : '' %>">
    <div class="modal-content pf-v6-c-modal-box">
      <div class="modal-header pf-v6-c-modal-box__header">
        <h4 class="modal-title pf-v6-c-modal-box__title" id="<%= id %>Label"><%= title %></h4>
      </div>
      <div class="modal-body pf-v6-c-modal-box__body">
        <%= yield %>
      </div>
      <div class="modal-footer pf-v6-c-modal-box__footer">
        <%= buttons.join.html_safe %>
      </div>
    </div>
  </div>
</div>
