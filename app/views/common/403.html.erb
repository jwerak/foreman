<% permissions = @missing_permissions.map { |permission| content_tag(:li, content_tag(:strong, permission.name)) } %>

<% content_for(:title, _("Permission denied")) %>
<div class="pf-v6-c-empty-state pf-m-lg">
  <div class="pf-v6-c-empty-state__content">
    <div class="pf-v6-c-empty-state__header">
      <div class="pf-v6-c-empty-state__icon">
        <i class="fas fa-lock" aria-hidden="true"></i>
      </div>
      <div class="pf-v6-c-empty-state__title">
        <h1 class="pf-v6-c-empty-state__title-text"><%= _("Permission denied") %></h1>
      </div>
    </div>
    <div class="pf-v6-c-empty-state__body">
      <p><%= _("You are not authorized to perform this action.") %></p>
      <p><%= _("Please request one of the required permissions listed below from a Foreman administrator:") %></p>
      <%= content_tag(:ul, permissions.join.html_safe, class: 'pf-v6-c-list') %>
    </div>
    <div class="pf-v6-c-empty-state__footer">
      <div class="pf-v6-c-empty-state__actions">
        <%= link_to(_('Back'), main_app.root_path, class: 'pf-v6-c-button pf-m-primary') %>
      </div>
    </div>
  </div>
</div>
