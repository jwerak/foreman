<div id="host-conflicts-modal" class="modal fade" style="display:none" role="dialog" aria-modal="true" aria-labelledby="host-conflicts-modal-title">
  <div class="modal-dialog">
    <div class="modal-content pf-v6-c-modal-box">
      <div class="modal-header pf-v6-c-modal-box__header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h4 class="modal-title pf-v6-c-modal-box__title" id="host-conflicts-modal-title"><%= _('DHCP lease conflicts have been detected') %></h4>
      </div>
      <div class="modal-body pf-v6-c-modal-box__body">
        <p><%= _('Please correct the error(s) below and submit your changes again.') %></p>
        <div class="pf-v6-c-alert pf-m-warning">
          <ul class="pf-v6-c-list">
            <% @host.errors[:dhcp_lease_error].each do |e| %>
              <li><%= e %></li>
            <% end %>
          </ul>
        </div>
      </div>
      <div class="modal-footer pf-v6-c-modal-box__footer">
        <button type="button" class="pf-v6-c-button pf-m-secondary" data-dismiss="modal"><%= _('OK') %></button>
      </div>
    </div>
  </div>
</div>
