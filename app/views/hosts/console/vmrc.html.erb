<% title "#{@console[:name]}" %>
<div class="pf-v6-c-empty-state pf-m-lg">
  <div class="pf-v6-c-empty-state__content">
    <div class="pf-v6-c-empty-state__header">
      <div class="pf-v6-c-empty-state__icon">
        <i class="pficon pficon-screen" aria-hidden="true"></i>
      </div>
      <div class="pf-v6-c-empty-state__title">
        <h1 class="pf-v6-c-empty-state__title-text"><%= _('VMRC Console') %></h1>
      </div>
    </div>
    <div class="pf-v6-c-empty-state__body">
      <p><%= _('To launch the VMRC console, you need the VMRC software installed.') %></p>
      <p><%= link_to(_('Download VMRC'), external_link_path(type: 'vmrc'), :target => '_blank', :rel => 'noopener noreferrer') %></p>
    </div>
    <div class="pf-v6-c-empty-state__footer">
      <div class="pf-v6-c-empty-state__actions">
        <%= link_to(_('Launch Console'),
                    @console[:console_url],
                    :class => 'pf-v6-c-button pf-m-primary',
                    :data => {
                      :disable_with => "<i class='fa fa-spinner fa-spin'></i> #{_('Opening VMRC Console')}..."
                    }) %>
        <% if @host && authorized_for(hash_for_host_path(@host)) %>
          <%= link_to(_("Back to host"), current_host_details_path(@host), :title => _('Back to host'), :class => 'pf-v6-c-button pf-m-secondary') %>
        <% end %>
      </div>
    </div>
  </div>
</div>
